# Copie para ".env" (ou configure como variáveis de ambiente no serviço de hospedagem). NUNCA publique este arquivo preenchido.

PORT=3000
# Pasta com banco de dados, áudios e imagens. Em produção deve ser um DISCO PERSISTENTE.
DATA_DIR=./data

# Administrador criado na primeira inicialização (só se ainda não existir nenhum usuário). Troque a senha depois.
ADMIN_EMAIL=rh@suaempresa.com.br
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_NAME=RH Jaguacy

# Quando o site estiver em HTTPS (obrigatório em produção)
SECURE_COOKIES=true
# Endereço(s) da Humand autorizados a incorporar o portal (confirme com a Humand). Separe por espaço.
FRAME_ANCESTORS=https://SUA-EMPRESA.humand.co

# ---- IA que simplifica o texto e cria o roteiro: anthropic | openai ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_LLM_MODEL=gpt-4o-mini

# ---- IA que transforma o roteiro em áudio MP3: openai | google ----
TTS_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=pt-BR-Neural2-C
